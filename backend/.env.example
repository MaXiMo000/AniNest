# Copy this to .env and fill in real values. Never commit .env itself.

PORT=8787
NODE_ENV=development

# Origin(s) allowed to call this API with credentials. Comma-separated for multiple.
FRONTEND_ORIGIN=http://localhost:5173

# Local file mode (default): leave DB_PATH unset and the DB lives at
# backend/data/aninest.db. Fine for local dev, or a host with a real
# persistent disk.
# DB_PATH=/var/data/aninest.db

# Remote Turso mode: set BOTH of these and DB_PATH is ignored entirely.
# Needed on hosts with no persistent disk (e.g. a free-tier Render web
# service — Render doesn't allow disks on the free plan at all). Free
# database at https://turso.tech — get these via:
#   turso db show <name> --url
#   turso db tokens create <name>
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=

# Comma-separated usernames to promote to admin (unlocks the watch-source
# curation page at #/admin/watch-sources). Applied on every boot, so
# register the account first, then set this and restart. Leave unset and
# nobody is an admin.
# ADMIN_USERNAMES=yourusername
# Same by user id (safer: an id can't be claimed by registering a name first).
# ADMIN_USER_IDS=1

# Free Google Cloud API key (YouTube Data API v3) powering the admin
# curation page's "search official channels" shortcut. Optional - without
# it, admins can still add links by pasting a URL directly, and anyone can
# still submit a link for review either way.
# YOUTUBE_API_KEY=

# Tidewatch dashboard (github.com/MaXiMo000/tidewatch): set to serve aggregate health numbers
# at GET /tidewatch/metrics to whoever holds this token (Bearer). Unset = the route does not
# exist. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# TIDEWATCH_METRICS_TOKEN=

# Proxies between visitors and this process (decides whose IP the rate limits
# see). Leave unset locally; 2 on Render (frontend /api rewrite + load balancer).
# TRUST_PROXY=2

# Optional password-reset and weekly digest emails. Either Resend (needs a domain you verified
# there; both must be set)...
# RESEND_API_KEY=
# MAIL_FROM=AniNest <noreply@your-domain.com>
# ...or any SMTP account, e.g. Gmail with an app password (no domain needed;
# Google account > Security > 2-Step Verification > App passwords). Host and
# port default to Gmail (smtp.gmail.com:465). Resend wins if both are set.
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-letter-app-password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Optional browser push alerts for new free episodes and chapters. Generate a
# pair once with `npx web-push generate-vapid-keys`; unset = the bell only.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Optional vibe search v2: when the rule-based reader meets words it doesn't
# know, Claude Haiku reads the request into the same filters (falls back to the
# rules on any error). Unset = rules only. VIBE_AI_DAILY_LIMIT caps calls per day.
# ANTHROPIC_API_KEY=
# VIBE_AI_DAILY_LIMIT=500
