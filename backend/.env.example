# Copy this to .env and fill in real values. Never commit .env itself.

PORT=8787
NODE_ENV=development

# Origin(s) allowed to call this API with credentials. Comma-separated for multiple.
FRONTEND_ORIGIN=http://localhost:5173

# Used to derive session token hashing pepper. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this instantly invalidates every existing session.
SESSION_SECRET=change-me-to-a-long-random-value

# Local file mode (default): leave DB_PATH unset and the DB lives at
# backend/data/aninest.db. Fine for local dev, or a host with a real
# persistent disk.
# DB_PATH=/var/data/aninest.db

# Remote Turso mode: set BOTH of these and DB_PATH is ignored entirely.
# Needed on hosts with no persistent disk (e.g. a free-tier Render web
# service — Render doesn't allow disks on the free plan at all). Free
# database at https://turso.tech — get these via:
#   turso db show <name> --url
#   turso db tokens create <name>
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=

# Comma-separated usernames to promote to admin (unlocks the watch-source
# curation page at #/admin/watch-sources). Applied on every boot, so
# register the account first, then set this and restart. Leave unset and
# nobody is an admin.
# ADMIN_USERNAMES=yourusername

# Free Google Cloud API key (YouTube Data API v3) powering the admin
# curation page's "search official channels" shortcut. Optional - without
# it, admins can still add links by pasting a URL directly, and anyone can
# still submit a link for review either way.
# YOUTUBE_API_KEY=
